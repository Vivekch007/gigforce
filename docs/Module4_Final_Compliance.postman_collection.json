{
  "info": {
    "_postman_id": "module4-0001-collection",
    "name": "GigForce Module 4 - Requisition, Identity & Reporting Compliance Suite",
    "description": "Postman Collection to verify Module 4 features: Requisitions, Identity (profile/roles), and basic reporting endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Setup & Auth",
      "item": [
        {
          "name": "Register Contractor (sample)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"New Contractor\",\n  \"email\": \"new.contractor@example.com\",\n  \"password\": \"Password123!\",\n  \"phone\": \"9000000010\",\n  \"role\": \"CONTRACTOR\",\n  \"orgCode\": \"ORG_ALPHA\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] }
          }
        }
      ]
    },
    {
      "name": "2. Requisition Flows",
      "item": [
        {
          "name": "Create Requisition (Hiring Manager)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{managerToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Requisition - Java Dev\",\n  \"orgCode\": \"ORG_ALPHA\",\n  \"positions\": 1,\n  \"requiredSkills\": [\"JAVA\", \"SPRING\"]\n}" },
            "url": { "raw": "{{baseUrl}}/requisitions", "host": ["{{baseUrl}}"], "path": ["requisitions"] }
          }
        },
        {
          "name": "Get Requisition by ID",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{managerToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/requisitions/1", "host": ["{{baseUrl}}"], "path": ["requisitions","1"] }
          }
        },
        {
          "name": "Close Requisition (Hiring Manager)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{managerToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CLOSED\"\n}" },
            "url": { "raw": "{{baseUrl}}/requisitions/1/close", "host": ["{{baseUrl}}"], "path": ["requisitions","1","close"] }
          }
        }
      ]
    },
    {
      "name": "3. Identity & Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{managerToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users","me"] }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{managerToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Name\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users","me"] }
          }
        },
        {
          "name": "Get Users (Admin)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        }
      ]
    },
    {
      "name": "4. Reporting / Audit Samples",
      "item": [
        {
          "name": "Get User Audit Logs (Admin)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/audit/user/1", "host": ["{{baseUrl}}"], "path": ["audit","user","1"] }
          }
        },
        {
          "name": "Get Assignments Report (Admin)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reports/assignments?orgCode=ORG_ALPHA", "host": ["{{baseUrl}}"], "path": ["reports","assignments"], "query": [{ "key": "orgCode", "value": "ORG_ALPHA" }] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "userToken", "value": "", "type": "string" }
  ]
}
